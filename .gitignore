# Legacy pre-rename paths: untracked corpora/artifacts still sit here on older
# checkouts, and un-ignoring them puts multi-GB (and license-gated) data one
# `git add -A` away from a commit.
benchmarks/results/
benchmarks/tasks-generated/
experiments/
results/
logs/
tmp/
temp/
data/
benchmarks/public/datasets
benchmarks/datasets
