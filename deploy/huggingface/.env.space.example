# FrontierAgent Hugging Face Space — local `docker run --env-file` template.
#
#   cp deploy/huggingface/.env.space.example .env.space.local
#   $EDITOR .env.space.local
#   docker run --rm -p 127.0.0.1:7860:7860 --env-file .env.space.local \
#     frontier-agent-hf-space
#
# On a real Space these are Variables, except the credentials at the bottom,
# which must be Secrets. Never commit a filled-in copy: `.env*` is git-ignored
# and excluded from the image, and it should stay that way.

# ── the model endpoint (required) ────────────────────────────────────────
# The API *base* URL of an OpenAI-compatible service, ending in /v1.
# NOT a Hugging Face model page — that is a web page, not an inference API.
# The endpoint must support tool/function calling.
OPENAI_BASE_URL=https://your-endpoint.example.com/v1
# The model name the endpoint serves (this goes in the request body).
OPENAI_MODEL=Apodex-1.1-mini

# ── display only ─────────────────────────────────────────────────────────
HF_MODEL_ID=apodex/Apodex-1.1-mini
# HF_MODEL_URL=https://huggingface.co/apodex/Apodex-1.1-mini

# ── demo limits (all optional; these are the defaults) ───────────────────
DEMO_WORKFLOW=react
DEMO_MAX_TURNS=24
DEMO_MAX_OUTPUT_TOKENS=4096
DEMO_TASK_TIMEOUT_SECONDS=600
DEMO_QUEUE_SIZE=4
DEMO_SESSION_TTL_SECONDS=3600
DEMO_MAX_PROMPT_CHARS=4000
DEMO_PUBLIC_MODE=true
# Accepted but clamped to 1: the runtime keeps per-process global state, so
# scale with replicas instead. See README.md §13.
DEMO_MAX_CONCURRENCY=1
# A closing report-synthesis LLM call. Better prose, noticeably slower.
DEMO_REPORTER=false
# WARNING | INFO | DEBUG
DEMO_LOG_LEVEL=WARNING

# ── web research ─────────────────────────────────────────────────────────
# web_fetch's page extraction is itself an LLM call. Without these, every fetch
# returns "Extraction failed" and the agent is left with search snippets.
# NOTE: this is the FULL chat-completions URL, unlike OPENAI_BASE_URL above.
SUMMARY_LLM_BASE_URL=
SUMMARY_LLM_MODEL_NAME=
# Only needed when the search/fetch traffic goes through an internal proxy
# instead of the vendors' public endpoints.
# SERPER_BASE_URL=https://google.serper.dev
# JINA_BASE_URL=https://r.jina.ai

# ── secrets (Space *Secrets*, never Variables) ───────────────────────────
OPENAI_API_KEY=
# Without this, web_search returns zero results and the agent looks broken.
SERPER_API_KEY=
# Credential for SUMMARY_LLM_BASE_URL above.
SUMMARY_LLM_API_KEY=
# Optional: better page retrieval for web_fetch.
JINA_API_KEY=
